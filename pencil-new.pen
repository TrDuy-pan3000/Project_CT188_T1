                      "name": "s4QuoteLine",
                      "fill": "#8a1012",
                      "width": 4,
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "P8x2r",
                      "name": "s4Quote",
                      "fill": "#8a1012",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Khách đến dâng chén sương lam\nKèm thêm chút mồi thắm đượm thâm giao\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 20,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "uKBMM",
                  "name": "s4Desc",
                  "fill": "#4A3B32",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Ngày Xuân sao có thể thiếu những chầu hàn huyên rôm rả, vài chén rượu nâng cạn cùng nhâm nhi miếng Khô Bò, Khô Gà đậm vị. Thay vì ngợp trong cỗ ngọt béo ngậy, chính vị mặn mặn, cay cay kích thích vị giác trở thành điểm nhấn thăng hoa cho bàn tiệc.\n\nTừng thớ thịt tẩm ướp tiêu hạt, mắc khén rừng và sấy củi gai làm bùng nổ hương sắc. Những cái chạm ly len lỏi giữa mùi thơm thớ khô, là dư vị khó tả của tình bằng hữu, chốn đoàn viên thiêng liêng rộn rã cười nói.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
