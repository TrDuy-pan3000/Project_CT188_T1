                    {
                      "type": "rectangle",
                      "id": "JV9xv",
                      "name": "s1QuoteLine",
                      "fill": "#8a1012",
                      "width": 4,
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "rdVBE",
                      "name": "s1Quote",
                      "fill": "#8a1012",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Gói bánh chưng xanh, buộc lạt ân tình\nNếp cẩm điểm tô, sắc xuân tươi rạng...\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 20,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "lE7Fd",
                  "name": "s1Desc",
                  "fill": "#4A3B32",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tại Bếp Nhà Ngọ, từng đòn Bánh Tét Lá Cẩm hay chiếc Bánh Chưng xanh đều được nâng niu tỉ mỉ từ khâu chọn nếp cái hoa vàng hạt đều tăm tắp, đến thịt mỡ và đậu xanh bùi béo. Sự hòa quyện giữa vị mặn của thịt, vị bùi của đậu và hương thơm lừng của nếp mới không đơn thuần là một món ăn, mà là bản giao hưởng gọi Tết về, gói ghém trọn vẹn lời chúc năm mới an khang, sum vầy và thịnh vượng.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
