                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Ngọt Ngào Dư Vị Khay Mứt Tết",
                      "lineHeight": 1.2,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 44,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "d6Fdn",
                  "name": "s3QuoteFrame",
                  "width": "fill_container",
                  "gap": 24,
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "ORuut",
                      "name": "s3QuoteLine",
                      "fill": "#8a1012",
                      "width": 4,
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "QkqLG",
                      "name": "s3Quote",
                      "fill": "#8a1012",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Trà đắng đố kị mứt thơm ngọt\nNhư đời nhân thế nếm đắng cay...\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 20,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "bHN0a",
                  "name": "s3Desc",
                  "fill": "#4A3B32",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Khay mứt Tết không chỉ là niềm vui trẻ nhỏ mà còn là những lời rôm rả mở đầu câu chuyện đầu năm của người lớn. Mứt dừa trắng muốt ngọt bùi, mứt gừng vàng ánh cay nồng ấm bụng, mứt sen trần thanh nhã như tà áo cô gái Hà Thành...\nChúng tôi sên tay từng mẻ mứt mộc bằng đường phèn, không nhuộm màu giả, để vị ngọt tự nhiên bừng lên dịu êm. Cùng một ấm chà xanh nóng hổi, ngày Xuân dường như chậm lại, để ta thưởng thực vị thanh tao và đón những bình yên chậm rãi.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
