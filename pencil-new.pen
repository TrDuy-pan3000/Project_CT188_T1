                      "fill": "#1A0A00",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Giò Lụa Chả Quế Thượng Hạng",
                      "lineHeight": 1.2,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 44,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mDTng",
                  "name": "s2QuoteFrame",
                  "width": "fill_container",
                  "gap": 24,
                  "children": [
                    {
                      "type": "rectangle",
                      "id": "hFtcK",
                      "name": "s2QuoteLine",
                      "fill": "#8a1012",
                      "width": 4,
                      "height": "fill_container"
                    },
                    {
                      "type": "text",
                      "id": "Hp6C9",
                      "name": "s2Quote",
                      "fill": "#8a1012",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Mâm cao cỗ đầy không gì sánh bằng tấm lòng.\nGiò chả thơm lừng, đậm tình nồng nàn góc bếp.\"",
                      "lineHeight": 1.5,
                      "fontFamily": "Cormorant Garamond",
                      "fontSize": 20,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "JF96d",
                  "name": "s2Desc",
                  "fill": "#4A3B32",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Giò Chả là phần tinh túy nhất trong mâm cỗ truyền thống. Để miếng giò lụa được trắng dòn sần sật, thịt phải là phần mông nạc vừa mới mổ, vẫn còn hơi ấm, đem giã đều tay ngay tức khắc.\nMiếng chả quế thì lại đòi hỏi sự khéo léo để nướng cho lớp vỏ ngoài ánh vàng như mật ong, cắn vào mềm ẩm, đượm quế tinh khiết. Chúng tôi gìn giữ công thức gia truyền trăm năm, hoàn toàn không chất bảo quản, chỉ gói ghém hương vị mộc mạc và chân thành nhất để trao đến vị giác của bạn.",
                  "lineHeight": 1.8,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "tsewP",
